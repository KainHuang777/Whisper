{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-pro",

  "provider": {
    "skyunion": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "SkyUnion API",
      "options": {
        "baseURL": "https://crs.skyunion.net/v1",
        "apiKey": "sk-pwEJSy7hphPcUEj9vmMrvQbkpYoB6YiqhArpEh4q3kZ6BX31"
      },
      "models": {
        // ═══ Claude 系列（aws） ═══
        "claude-opus-5":              { "name": "Claude Opus 5" },
        "claude-opus-4-8":            { "name": "Claude Opus 4.8" },
        "claude-haiku-4-5-20251001":  { "name": "Claude Haiku 4.5" },
        "claude-sonnet-5":            { "name": "Claude Sonnet 5" },
        // ═══ GPT 系列（azure） ═══
        "gpt-5.6-sol":                { "name": "GPT-5.6 Sol" },
        "gpt-5.6-luna":               { "name": "GPT-5.6 Luna" },
        "gpt-5.6-terra":              { "name": "GPT-5.6 Terra" },
        "gpt-5.5":                    { "name": "GPT-5.5" },
        "gpt-5.4":                    { "name": "GPT-5.4" },
        "gpt-5.3-codex":              { "name": "GPT-5.3 Codex" },
        "gpt-5.2":                    { "name": "GPT-5.2" },
        "gpt-4.1-mini":               { "name": "GPT-4.1 Mini" },
        // ═══ DeepSeek 系列 ═══
        "azure-ds-v4-pro":            { "name": "DeepSeek V4 Pro (Azure)" },
        "azure-ds-v4-flash":          { "name": "DeepSeek V4 Flash (Azure)" },
        "deepseek-v4-flash":          { "name": "DeepSeek V4 Flash (Volcengine)" }
      }
    }
  },

  "skills": {
    "paths": [
      ".opencode/skills",
      "D:/work/fortest/Fusion/opencode_fusion/.opencode/skills"
    ]
  },

  "agent": {
    "fusion-deepseek": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-pro",
      "hidden": true,
      "description": "Fusion panel: DeepSeek V4 Pro — technical depth, code reasoning, logical analysis. WARNING: conflicts if Judge is also DeepSeek V4 Pro"
    },
    "fusion-kimi": {
      "mode": "subagent",
      "model": "opencode-go/kimi-k2.7-code",
      "hidden": true,
      "description": "Fusion panel: Kimi K2.7 Code — code architecture, logic flow, implementation"
    },
    "fusion-qwen": {
      "mode": "subagent",
      "model": "opencode-go/qwen3.7-plus",
      "hidden": true,
      "description": "Fusion panel: Qwen3.7 Plus — comprehensive analysis, broad context, strategy (budget tier)"
    },
    "fusion-glm": {
      "mode": "subagent",
      "model": "opencode-go/glm-5.2",
      "hidden": true,
      "description": "Fusion panel: GLM-5.2 — creative thinking, alternative angles, counterarguments"
    },
    "fusion-gemini": {
      "mode": "subagent",
      "model": "google/gemini-3.5-flash",
      "hidden": true,
      "description": "Fusion panel: Gemini 3.5 Flash (free tier) — Google architecture diversity, alternative framing, blind spot detection"
    },
    "fusion-skyunion": {
      "mode": "subagent",
      "model": "skyunion/claude-haiku-4-5-20251001",
      "hidden": true,
      "description": "Fusion panel: Claude Haiku 4.5 (SkyUnion API) — Anthropic architecture diversity, nuanced reasoning, safety perspective"
    },
    "fusion-sonnet": {
      "mode": "subagent",
      "model": "skyunion/claude-sonnet-5",
      "hidden": true,
      "description": "Fusion panel: Claude Sonnet 5 (SkyUnion API) — Anthropic flagship, deep contextual reasoning, safety alignment"
    },

    "fusion-budget-ds": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "hidden": true,
      "description": "Fusion budget panel: DeepSeek V4 Flash — fast, low-cost technical analysis. WARNING: conflicts if Judge is DeepSeek family"
    },
    "fusion-budget-mimo": {
      "mode": "subagent",
      "model": "opencode-go/mimo-v2.5",
      "hidden": true,
      "description": "Fusion budget panel: MiMo V2.5 — fast, low-cost broad coverage"
    },

    "fusion-fiction-plot": {
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "hidden": true,
      "description": "Fiction editor: Plot, pacing, scene structure, narrative logic"
    },
    "fusion-fiction-character": {
      "mode": "subagent",
      "model": "opencode-go/qwen3.7-plus",
      "hidden": true,
      "description": "Fiction editor: Character, emotion, dialogue, relationship dynamics"
    },
    "fusion-fiction-prose": {
      "mode": "subagent",
      "model": "opencode-go/mimo-v2.5",
      "hidden": true,
      "description": "Fiction editor: Prose style, imagery, sentence craft, narrative voice"
    },

    "build": {
      "permission": {
        "task": {
          "fusion-*": "allow",
          "*": "allow"
        }
      }
    },

    "general": {
      "permission": {
        "task": {
          "fusion-*": "allow",
          "*": "allow"
        }
      }
    }
  },

  "permission": {
    "skill": {
      "fusion-research": "allow",
      "fiction-editor": "allow",
      "*": "allow"
    }
  }
}
